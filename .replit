run = "npm run dev"
[nix]
channel = "stable-24_05"
[deployment]
run = ["sh", "-c", "PORT=3000 HOSTNAME=0.0.0.0 node .next/standalone/server.js"]
build = ["sh", "-c", "npm install && NODE_OPTIONS='--max-old-space-size=1536' npm run build && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public"]
[[ports]]
localPort = 3000
externalPort = 80
