DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sarani
ADMIN_PASSWORD=your-admin-password-here
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ─── Phase 3: External Integrations ─────────────────────────────────────────

# Microsoft SharePoint / OneDrive (Graph API - client_credentials flow)
MICROSOFT_TENANT_ID=your-azure-tenant-id
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret

# ClickUp (API v2 - personal API token)
CLICKUP_API_KEY=pk_your-clickup-api-key
CLICKUP_WORKSPACE_ID=your-workspace-id

# OpenAI (optional — LinkedIn visual AI backgrounds with gpt-image-1)
# If not set, falls back to Satori-only rendering
OPENAI_API_KEY=sk-your-openai-api-key

# Evoliz (optional — graceful degradation when not configured)
EVOLIZ_API_KEY=your-evoliz-api-key
EVOLIZ_COMPANY_ID=your-evoliz-company-id
